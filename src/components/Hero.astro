---
---
<section class="hero">
  <div class="hero-inner reveal">
    <div class="hero-text">
      <h1>You're busy.<br /><em>Your website is handled.</em></h1>
      <p class="hero-sub">
        For consultants, coaches, and small organizations who'd rather
        focus on their work than manage a website.
      </p>

      <div class="hero-price">
        <span class="hero-price-main">$0 upfront &middot; $75/month</span>
        <span class="hero-price-sub">Built, hosted, and maintained by a real person.</span>
      </div>

      <div class="hero-ctas">
        <a href="#how-it-works" class="btn btn-primary">See How It Works</a>
        <a href="#example" class="link-arrow">View a real example <span aria-hidden="true">→</span></a>
      </div>

    </div>

    <div class="hero-img-wrap">
      <img
        src="/images/hero-photo.jpg"
        alt="A busy professional at their desk, focused on their work"
        class="hero-img"
        width="560"
        height="640"
        loading="eager"
      />
    </div>
  </div>
</section>
